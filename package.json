{
	"name": "fortunes-platform",
	"version": "0.4.0",
	"description": "The code the Little Fortunes apps share: the suite stylesheet, Svelte components and Playwright helpers (the Python half is under python/)",
	"license": "MIT",
	"type": "module",
	"exports": {
		"./styles.css": "./styles/suite.css",
		"./app": "./svelte/app.ts",
		"./types": "./svelte/types.ts",
		"./settings": "./svelte/settings.ts",
		"./*.svelte": {
			"svelte": "./svelte/*.svelte",
			"default": "./svelte/*.svelte"
		},
		"./testing/viewport": {
			"types": "./testing/viewport.d.ts",
			"default": "./testing/viewport.js"
		},
		"./testing/static-server.mjs": "./testing/static-server.mjs",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -p testing/tsconfig.json",
		"check": "svelte-check --tsconfig ./tsconfig.json --threshold warning",
		"test": "npm run check && npm run build && git diff --exit-code -- testing/viewport.js testing/viewport.d.ts && node --test testing/*.test.mjs styles/*.test.mjs && vitest run"
	},
	"peerDependencies": {
		"@playwright/test": "^1.64.0",
		"svelte": "^5.56.1"
	},
	"peerDependenciesMeta": {
		"@playwright/test": {
			"optional": true
		}
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/svelte": "^5.4.2",
		"jsdom": "^29.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.7",
		"vitest": "^5.1.0"
	}
}
