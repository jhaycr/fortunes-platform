{
	"name": "fortunes-platform",
	"version": "0.3.0",
	"description": "The code the Little Fortunes apps share: the suite stylesheet, Svelte components and Playwright helpers (the Python half is under python/)",
	"license": "MIT",
	"type": "module",
	"exports": {
		"./SettingCard.svelte": {
			"svelte": "./svelte/SettingCard.svelte",
			"default": "./svelte/SettingCard.svelte"
		},
		"./settings": "./svelte/settings.ts",
		"./styles.css": "./styles/suite.css",
		"./testing/viewport": {
			"types": "./testing/viewport.d.ts",
			"default": "./testing/viewport.js"
		},
		"./testing/static-server.mjs": "./testing/static-server.mjs",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -p testing/tsconfig.json",
		"check": "svelte-check --tsconfig ./tsconfig.json --threshold warning",
		"test": "npm run check && npm run build && git diff --exit-code -- testing/viewport.js testing/viewport.d.ts && node --test testing/*.test.mjs styles/*.test.mjs"
	},
	"peerDependencies": {
		"@playwright/test": "^1.64.0",
		"svelte": "^5.56.1"
	},
	"peerDependenciesMeta": {
		"@playwright/test": {
			"optional": true
		}
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3"
	}
}
